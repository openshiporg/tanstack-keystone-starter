{
  "name": "tanstack-keystone-starter",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "cms:generate": "tsx scripts/cms-generate.ts",
    "keystone:build": "npm run cms:generate",
    "migrate:gen": "tsx scripts/cms-migrate.ts",
    "migrate": "npm run cms:generate && prisma migrate deploy && prisma generate",
    "cms:check": "tsx scripts/cms-generate.ts --check && tsx scripts/compare-cms-prisma-schema.ts && tsx scripts/check-cms-prisma-delegates.ts",
    "cms:check:prisma": "tsx scripts/compare-cms-prisma-schema.ts && tsx scripts/check-cms-prisma-delegates.ts",
    "dev": "npm run cms:generate && vite dev --port ${PORT:-3000}",
    "dev:seeded": "CMS_ADAPTER=memory CMS_BOOTSTRAP_MODE=seeded npm run dev",
    "dev:fresh": "CMS_ADAPTER=memory CMS_BOOTSTRAP_MODE=fresh npm run dev",
    "dev:prisma": "CMS_ADAPTER=prisma npm run dev",
    "build": "npm run cms:generate && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cms": "tsx scripts/validate-cms-config.ts && tsx scripts/validate-cms-crud.ts && tsx scripts/validate-cms-admin-meta.ts && tsx scripts/validate-cms-actions.ts && tsx scripts/validate-cms-access-filters.ts && tsx scripts/validate-cms-item-field-access.ts && tsx scripts/validate-cms-singleton.ts && tsx scripts/validate-cms-document-runtime.ts && tsx scripts/validate-cms-document-component-parity.ts && tsx scripts/validate-fields-document-links.ts && tsx scripts/validate-fields-document-structure-local.ts && tsx scripts/validate-cms-context-db.ts && tsx scripts/validate-cms-nested-hooks.ts && tsx scripts/validate-cms-virtual-fields.ts && tsx scripts/validate-cms-select-fields.ts && tsx scripts/validate-cms-password-fields.ts && tsx scripts/validate-cms-document-fields.ts && tsx scripts/validate-cms-auth.ts && tsx scripts/validate-cms-storage.ts && tsx scripts/validate-cms-graphql-upload.ts && tsx scripts/validate-cms-graphql-upload-http.ts",
    "test:cms:auth": "tsx scripts/validate-cms-auth.ts",
    "test:cms:auth:8.1": "node scripts/validate-auth-8.1-differential.mjs",
    "test:cms:auth:continuity": "node scripts/validate-cms-auth-continuity.mjs",
    "test:cms:storage": "tsx scripts/validate-cms-storage.ts",
    "test:cms:structure": "node scripts/validate-fields-document-structure.mjs",
    "test:cms:document:links": "tsx scripts/validate-fields-document-links.ts",
    "test:cms:providers": "tsx scripts/validate-cms-prisma-provider-dispatch.ts && tsx scripts/validate-cms-prisma-temp-client.ts && tsx scripts/validate-cms-prisma-mysql-live.ts",
    "test:cms:upload": "tsx scripts/validate-cms-graphql-upload.ts && tsx scripts/validate-cms-graphql-upload-http.ts",
    "test:cms:dynamic": "tsx scripts/validate-cms-dynamic-model.ts && tsx scripts/validate-cms-runtime-omit.ts && tsx scripts/validate-cms-prisma-preflight.ts && tsx scripts/validate-cms-prisma-runtime-fixture.ts && tsx scripts/validate-cms-prisma-temp-client.ts",
    "test:cms:workflow": "node scripts/validate-cms-schema-workflow.mjs",
    "test:cms:relationships:matrix": "GAP08_HEAVY_CLEARANCE=1 node scripts/validate-gap08-relationship-matrix.mjs",
    "test:cms:access:parity": "node scripts/validate-cms-access-parity.mjs",
    "test:cms:hooks:parity": "tsx scripts/validate-cms-hook-parity.ts",
    "test:cms:context:semantics": "tsx scripts/validate-cms-context-semantics.ts",
    "test:cms:calendar-day": "tsx scripts/validate-cms-calendar-day.ts",
    "test:cms:graphql-builder": "tsx scripts/fixtures/cms-graphql-builder.ts",
    "test:production:adapter": "tsx scripts/validate-production-adapter-selection.ts",
    "test:cms:differential": "node scripts/validate-keystone-differential.mjs",
    "test:dashboard:ai": "tsx scripts/validate-dashboard-completion.ts",
    "test:dashboard:http": "tsx scripts/validate-dashboard-http.ts",
    "test:dashboard:browser": "npm run build && DASHBOARD_BROWSER_CURRENT_BUILD=1 node scripts/validate-dashboard-browser.mjs",
    "test:dashboard:browser:fresh": "npm run build && DASHBOARD_BROWSER_CURRENT_BUILD=1 DASHBOARD_BROWSER_MATRIX_MODE=fresh node scripts/validate-dashboard-browser.mjs",
    "test:dashboard:browser:prisma": "node scripts/validate-dashboard-browser-prisma.mjs",
    "test:dashboard:browser:arbitrary": "node scripts/validate-dashboard-arbitrary-browser.mjs",
    "test:dashboard:browser:advanced-document": "node scripts/validate-dashboard-advanced-document-browser.mjs",
    "test:dashboard:a11y": "node scripts/validate-dashboard-gap11-accessibility.mjs",
    "test:dashboard:field-zoo:prisma": "node scripts/validate-dashboard-field-zoo-prisma.mjs",
    "test:dashboard:field-zoo": "rm -rf node_modules/.nitro && DASHBOARD_FIELD_ZOO=1 node scripts/validate-dashboard-arbitrary-browser.mjs",
    "test:dashboard:browser:launcher-cleanup": "npm run build && DASHBOARD_BROWSER_CURRENT_BUILD=1 node scripts/validate-dashboard-launcher-cleanup.mjs",
    "test:dashboard:browser:matrix": "npm run test:dashboard:browser && npm run test:dashboard:browser:fresh && npm run test:dashboard:browser:prisma && npm run test:dashboard:browser:arbitrary",
    "test:nitro:errors": "node scripts/validate-nitro-error-runtime.mjs",
    "test:dependencies": "tsx scripts/validate-runtime-dependencies.ts",
    "test:production:baseline": "node scripts/validate-production-baseline.mjs",
    "audit:next-source": "node scripts/audit-next-keystone-source.mjs",
    "audit:next-models": "node scripts/audit-next-model-portability.mjs",
    "test:sibling:oracle": "node scripts/validate-sibling-oracle.mjs",
    "test:openfront-consumers": "tsx scripts/validate-openfront-consumers.mjs",
    "test:openfront-runtime-canary": "node scripts/validate-openfront-runtime-canary.mjs",
    "test:os-org:real-consumer": "node scripts/validate-os-org-real-consumer-canary.mjs",
    "test:providers:local": "tsx scripts/validate-cms-storage.ts && tsx scripts/validate-cms-smtp-wire.ts",
    "test:source-cutover": "node scripts/validate-source-cutover.mjs",
    "test:cms:prisma": "tsx scripts/validate-cms-prisma.ts",
    "test:cms:prisma:auth": "tsx scripts/validate-cms-prisma-auth.ts",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate": "npm run cms:generate && DATABASE_URL=${DATABASE_URL:-postgresql://cms_generate:cms_generate@127.0.0.1:1/cms_generate} prisma generate",
    "db:push": "npm run cms:generate && prisma db push && npm run db:generate",
    "db:seed": "npm run db:seed:demo",
    "db:seed:demo": "prisma db seed",
    "db:reset:fresh": "prisma db push --force-reset --skip-generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@braintree/sanitize-url": "^7.1.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@graphql-ts/extend": "^1.0.3",
    "@graphql-ts/schema": "^0.6.4",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.28",
    "@tanstack/router-plugin": "^1.132.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.0",
    "graphql-upload": "^15.0.2",
    "graphql-yoga": "^5.21.0",
    "lucide-react": "^0.545.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260717-080150-bfc2f5ef",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.7.0",
    "slate": "^0.126.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/eslint-config": "0.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
