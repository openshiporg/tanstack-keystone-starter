# Memory is the default-safe adapter when no DATABASE_URL is set.
# Set CMS_ADAPTER=prisma to force persistent Prisma-backed GraphQL CRUD.
CMS_ADAPTER=memory

# Memory bootstrap mode:
# - seeded (default): demo users/data preloaded
# - fresh: empty lists (forces /dashboard/init flow until first admin is created)
CMS_BOOTSTRAP_MODE=seeded
# Dev-only bypass for GraphQL smoke testing. Dashboard requests disable this per request.
# Leave false/unset for Keystone-like auth behavior.
CMS_DEV_AUTH_FALLBACK=false
# Required when the fallback is explicitly enabled; use an ID from your auth list.
CMS_DEV_AUTH_ITEM_ID=

# Source starter uses PostgreSQL. Prisma is configured for PostgreSQL because the
# starter models include JSON fields.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tanstack_keystone_starter?schema=public"

# Required for durable auth/session cookies outside tests. Use at least 32 chars.
SESSION_SECRET="replace-this-with-at-least-32-characters"

# Production request/readiness controls. GraphQL defaults to 25 MiB and readiness
# defaults to 5 seconds when unset. Request completion logs are automatic in
# production and can be enabled explicitly elsewhere with CMS_REQUEST_LOGS=1.
CMS_GRAPHQL_MAX_BODY_BYTES="26214400"
CMS_READINESS_TIMEOUT_MS="5000"
CMS_REQUEST_LOGS="0"
# Optional comma-separated browser image origins beyond S3_ENDPOINT.
CMS_CSP_IMG_ORIGINS=""

# Source-compatible S3 image storage. Replace every placeholder before upload use.
S3_BUCKET_NAME="keystone-test"
S3_REGION="ap-southeast-2"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_ENDPOINT="https://sfo3.digitaloceanspaces.com"

# Password reset delivery. SMTP_STORE_LINK is the public application origin.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="replace-me"
SMTP_PASSWORD="replace-me"
SMTP_FROM="no-reply@example.com"
SMTP_STORE_LINK="http://localhost:3000"
